# ---------------------------------------------------------------------
# SHARED SETTINGS — same for every bot, set these once
# ---------------------------------------------------------------------
APP_ID=
API_HASH=
OWNER_ID=
CHANNEL_ID=

FORCE_SUB_CHANNEL_1=0
FORCE_SUB_CHANNEL_2=0
FORCE_SUB_CHANNEL_3=0
FORCE_SUB_CHANNEL_4=0

ADMINS=
START_MESSAGE=
FORCE_SUB_MESSAGE=
CUSTOM_CAPTION=
PROTECT_CONTENT=False
DISABLE_CHANNEL_BUTTON=False

# PORT is injected automatically by Railway — you normally don't set this
# yourself. Only ONE shared health-check web server is started no matter
# how many bots are running below, so there's no port clash.
# PORT=8080

# ---------------------------------------------------------------------
# PER-BOT SETTINGS — repeat this block for each bot you want to run
# (up to 10). Just leave a slot's BOT_TOKEN_<n> empty/unset to disable it.
